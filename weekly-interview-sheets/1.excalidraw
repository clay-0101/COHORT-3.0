      "type": "text",
      "x": 124.64668592125486,
      "y": 8751.28697889912,
      "width": 508.1997985839844,
      "height": 35,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#000000",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1sV",
      "roundness": null,
      "seed": 600605067,
      "version": 169,
      "versionNonce": 1263878187,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791635855254,
      "link": null,
      "locked": false,
      "text": "When can force-push become risky?",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When can force-push become risky?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t0BRZmrurTugwjtNgd2Pv",
      "type": "text",
      "x": -0.9854079527214026,
      "y": 9608.98892931994,
      "width": 970.1995849609375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#000000",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1sl",
      "roundness": null,
      "seed": 478852261,
      "version": 292,
      "versionNonce": 150014699,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791636384222,
      "link": null,
      "locked": false,
      "text": "How would you communicate a significant change to the reviewer?",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How would you communicate a significant change to the reviewer?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ikwua1X5uRqb5S6oBJqiw",
      "type": "text",
      "x": -300.00053767864057,
      "y": 8511.16483115006,
      "width": 1606,
      "height": 100,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "#000000",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1t",
      "roundness": null,
      "seed": 1183552485,
      "version": 369,
      "versionNonce": 1643465253,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791635819429,
      "link": null,
      "locked": false,
      "text": "My default choice would be a new commit while the PR is under review.\nWhy? Because the reviewer can easily distinguish the original work from the changes made after receiving feedback.\nHowever, if the team asks you to keep the PR history clean, you can squash the commits before merging.\nOne important detail: squashing is not always necessary, and amending or squashing commits that have already been pushed can require a force-push.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "My default choice would be a new commit while the PR is under review.\nWhy? Because the reviewer can easily distinguish the original work from the changes made after receiving feedback.\nHowever, if the team asks you to keep the PR history clean, you can squash the commits before merging.\nOne important detail: squashing is not always necessary, and amending or squashing commits that have already been pushed can require a force-push.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tm41iPauvZEMt-1xRIeXT",
      "type": "text",
      "x": 130.63062518735103,
      "y": 8874.012932416144,
      "width": 528,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#000000",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1v",
      "roundness": null,
      "seed": 463261221,
      "version": 164,
      "versionNonce": 1129109445,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791636237617,
      "link": null,
      "locked": false,
      "text": "git push --force-with-lease origin feature/login",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "git push --force-with-lease origin feature/login",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5Fi1397iSyjRK7ddWYDkz",
      "type": "text",
      "x": 105.0877711822207,
      "y": 9032.412017223118,
      "width": 737,
      "height": 25,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "#000000",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1w",
      "roundness": null,
      "seed": 1849900843,
      "version": 148,
      "versionNonce": 281390475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791636199084,
      "link": null,
      "locked": false,
      "text": "Imagine your teammate has pushed another commit to the same branch:",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Imagine your teammate has pushed another commit to the same branch:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "whUzgTJ8aIVP8RCMd-Qnz",
      "type": "text",
      "x": 340.6493768520066,
      "y": 9105.55652771814,
      "width": 231,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#000000",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1y",
      "roundness": null,
      "seed": 1530599627,
      "version": 143,
      "versionNonce": 2005647787,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791636245319,
      "link": null,
      "locked": false,
      "text": "GitHub: A → B → C → D\nLocal:  A → B → C'",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GitHub: A → B → C → D\nLocal:  A → B → C'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "F1ivRg5XpwkOEEVmASERq",
      "type": "text",
      "x": -171.0025218048362,
      "y": 9202.921188021102,
      "width": 1419,
      "height": 50,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#000000",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1z",
      "roundness": null,
      "seed": 848891915,
      "version": 50,
      "versionNonce": 683591397,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791636222177,
      "link": null,
      "locked": false,
      "text": "If you blindly force-push your local history, commit D may disappear from the branch's visible history.\nThe commit might still be recoverable, but your teammate's work can become difficult to find and may be excluded from the branch.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If you blindly force-push your local history, commit D may disappear from the branch's visible history.\nThe commit might still be recoverable, but your teammate's work can become difficult to find and may be excluded from the branch.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kkySyN3-dU1fuGPd8yyfR",
      "type": "text",
      "x": 96.5097395973595,
      "y": 9750.483257963815,
      "width": 759,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b22",
      "roundness": null,
      "seed": 221971371,
      "version": 86,
      "versionNonce": 672640491,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791636467277,
      "link": null,
      "locked": false,
      "text": "Suppose the reviewer asked you to improve email validation, but while\nworking on it, you also changed how the login API handles errors.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suppose the reviewer asked you to improve email validation, but while working on it, you also changed how the login API handles errors.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
